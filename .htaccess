RewriteEngine On

# Let real files/directories (the static frontend, assets, uploads) serve as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything under /api/v1/... goes through the front controller.
RewriteCond %{REQUEST_URI} ^/api/v1/
RewriteRule ^ index.php [L]

# Never allow the .env file to be served directly.
<Files ".env">
  Require all denied
</Files>
